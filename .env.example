# Local defaults work without credentials. Never use file: storage on Vercel.
DATABASE_URL=file:.data/event-gate.db
# For cloud: libsql://your-database.turso.io and its database token
DATABASE_AUTH_TOKEN=
# Optional automatic email delivery
RESEND_API_KEY=
EMAIL_FROM=
# Optional first-run administrator, configured only in secure hosting settings.
# Used only if the database has no users; never overwrites an existing account.
# INITIAL_USER_EMAIL=
# INITIAL_USER_PASSWORD=
# INITIAL_USER_NAME=
